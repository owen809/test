# Supabase — get these from https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Admin token — choose any strong random string, e.g. openssl rand -hex 32
# You'll type this into the admin login screen at /admin
ADMIN_TOKEN=change_me_to_a_strong_random_string

# Resend — get API key at https://resend.com (free 3000 emails/mo)
RESEND_API_KEY=re_your_api_key_here

# ---- Hardware-specific settings ----
# Python executable inside your venv (use full path to avoid "wrong python" bugs)
# Examples:
#   Windows WSL2:  /home/yourname/test/venv/bin/python
#   Linux native:  /home/yourname/test/venv/bin/python
#   Windows native with venv:  C:\Users\yourname\test\venv\Scripts\python.exe
PYTHON_BIN=python

# Which converter script to use:
#   convert_7900xtx.py  → max quality, 7900XTX only (ROCm, 24 GB VRAM)
#   convert.py          → auto-detects hardware (safe default for any machine)
CONVERT_SCRIPT=convert_7900xtx.py
